APP_ENV=production
# --- Database (Neon / Supabase / Render PostgreSQL) ---
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database?sslmode=require
SECRET_KEY=GENERATE_A_STRONG_RANDOM_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- API Docs ---
# Set to false in production to hide /docs and /redoc endpoints
ENABLE_API_DOCS=false

# --- Misc ---
EVENT_DEFAULT_DURATION_HOURS=3

# ============================================================
# Redis Cache
# ============================================================
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=true
REDIS_CACHE_TTL_SECONDS=300

# ============================================================
# AI / Agent / RAG
# ============================================================

# Agent chat uses Groq when this key is configured. OpenRouter remains for embeddings.
GROQ_API_KEY=your_groq_api_key_here
# Required: choose a Groq chat model in the environment.
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Used for chat only when GROQ_API_KEY is not configured.
OPENROUTER_MODEL=openai/gpt-oss-120b
# Tried in order when the primary OpenRouter model fails.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Per-request provider timeout (5-300 seconds) and retry policy.
LLM_TIMEOUT_SECONDS=10
# Upper bound across the primary model and all fallback attempts.
LLM_TOTAL_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=0
CHAT_TEMPERATURE=0.0

# OpenRouter embeddings (only embedding provider). Model outputs 2048 dimensions.
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_DIM=2048
RAG_ACTIVE_EMBEDDING_INDEX=nvidia
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16

# --- Chunking ---
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=80

# --- Hybrid retrieval ---
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
FUSED_TOP_K=10
FINAL_TOP_K=4

ENABLE_RERANKER=false
ENABLE_METADATA_EXTRACTION=true
ENABLE_HALLUCINATION_CHECK=true
MAX_GENERATION_RETRIES=1

# --- Agent ---
AGENT_MAX_TOOL_LOOPS=6
MEMORY_WINDOW_MESSAGES=10

KNOWLEDGE_DOCS_DIR=documents
